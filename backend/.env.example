# JeevaLink Backend Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Leave empty to use automatic in-memory MongoDB for local dev / tests, or provide Atlas/local URI)
MONGODB_URI=

# JWT Authentication Secret
JWT_SECRET=jeevalink_super_secure_jwt_secret_key_2025_safe_token_generator

# JWT Expiration
JWT_EXPIRES_IN=7d

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Optional Seed Admin Credentials
ADMIN_NAME=JeevaLink Administrator
ADMIN_EMAIL=admin@jeevalink.org
ADMIN_PASSWORD=AdminSecurePass123!
