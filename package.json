{
  "name": "jeevalink",
  "version": "1.0.0",
  "description": "JeevaLink — Healthcare and Community Support Platform for Blood and Organ Services",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "start": "npm --prefix backend run start",
    "test": "npm --prefix backend run test",
    "seed": "npm --prefix backend run seed",
    "seed:admin": "npm --prefix backend run seed:admin"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
